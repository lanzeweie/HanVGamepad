<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HanVGamepad.Cli</RootNamespace>
    <AssemblyName>hanvgamepad</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>HanVGamepad Contributors</Authors>
    <Product>HanVGamepad</Product>
    <Description>HanVGamepad headless host: turn any smartphone browser into a virtual PC controller.</Description>
    <Copyright>Copyright © 2026 HanVGamepad Contributors</Copyright>
    <!-- CLI 与桌面端共用同一份图标（不复制文件，直接引用桌面端资源）。 -->
    <ApplicationIcon>..\desktop\Resources\HanVGamepadIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\server\HanVGamepad.Server.csproj" />
    <ProjectReference Include="..\driver\HanVGamepad.Driver.csproj" />
  </ItemGroup>

  <!-- React SPA 产物（web-client 构建输出在 ../desktop/wwwroot）随 CLI 一起复制到输出目录，
       否则 CLI 启动后首页 404、启动自检会拒绝服务上线。 -->
  <ItemGroup>
    <Content Include="..\desktop\wwwroot\**\*" Condition="Exists('..\desktop\wwwroot')">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
