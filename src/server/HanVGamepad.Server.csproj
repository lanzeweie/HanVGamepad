<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HanVGamepad.Server</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebRTC 纯托管实现；Microsoft.AspNetCore.App 由 Sdk.Web 隐式引入（显式引用会触发 NETSDK1086）。 -->
    <PackageReference Include="SIPSorcery" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\driver\HanVGamepad.Driver.csproj" />
  </ItemGroup>

</Project>
